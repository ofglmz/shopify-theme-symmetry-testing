          "type": "text_block",
          "settings": {
            "enable_media": true,
            "image": "shopify://shop_images/imgi_104_s-l1600.jpg",
            "title": "Modern & Chic",
            "text": "<p><br/>Our products are available in limited quantities to maintain premium quality and exclusivity. From classic gold tones to minimalist silver finishes, there’s a piece for every mood and moment.<br/><br/></p>",
